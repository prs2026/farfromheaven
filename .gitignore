# Python
__pycache__/
*.pyc
.venv/

# Monte Carlo result pickles (large, regenerated by montecarlorunner.py)
*.pkl

# PyInstaller build intermediates for the CDX1 summary tool
tools/cdx1_summary/build/
tools/cdx1_summary/*.spec

# Sim output folders (*_out): ignored entirely. Each dated run also copies its
# main outputs into <config>_latest/ beside the design (summary.pdf, summary.txt,
# flight.kml, vibration files, flight.mp4); that folder is what gets committed
*_out/
# Superseded by <config>_latest/flight.mp4
*_latest.mp4
