# Python
__pycache__/
*.pyc
.venv/

# Monte Carlo result pickles (large, regenerated by montecarlorunner.py)
*.pkl

# PyInstaller build intermediates for the CDX1 summary tool
tools/cdx1_summary/build/
tools/cdx1_summary/*.spec

# Sim output folders (*_out): ignored entirely; the sim writes a single
# <config>_latest.pdf next to the folder, and that file is what gets committed
*_out/
